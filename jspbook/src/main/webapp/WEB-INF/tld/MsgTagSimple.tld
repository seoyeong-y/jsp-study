<?xml version="1.0" encoding="UTF-8"?>
<j2ee:taglib version="2.0"
	xmlns:j2ee="http://java.sun.com/xml/ns/j2ee"
	xmlns:xml="http://www.w3.org/XML/1998/namespace"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd ">
	<j2ee:tlib-version>0.0</j2ee:tlib-version>
	<j2ee:short-name>MsgTagSimple</j2ee:short-name>
	<j2ee:tag>
		<j2ee:name>print</j2ee:name>
		<j2ee:tag-class>jspbook.ch08.MsgTagSimpleHandler</j2ee:tag-class>
		<j2ee:body-content>empty</j2ee:body-content>
	</j2ee:tag>
</j2ee:taglib>
